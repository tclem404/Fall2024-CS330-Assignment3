@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">NumberBox</h1>
    <h3 class="display-6">One of the Movie and Actor Databases of All Time</h3>
    <p class="homePara">This is a website to catalog Actors and Movies, generating AI tweets about actors and AI reviews about the movies.
         Add all the Actors and Movies to your heart's content, or look at what we already have up.</p>
    <p class="homePara">View Our List of Actors <a class="nav-link text-light" asp-area="" asp-controller="Actors" asp-action="Index">Here</a></p>
    <p class="homePara">View Our List of Movies <a class="nav-link text-light" asp-area="" asp-controller="Movies" asp-action="Index">Here</a></p>
    <p class="homePara">Find Out What (AI) Critics Think with Our List of Movie Reviews <a class="nav-link text-light" asp-area="" asp-controller="Reviews" asp-action="Index">Here</a></p>
    <p class="homePara">Find Out What the (AI) Public Thinks of Actors <a class="nav-link text-light" asp-area="" asp-controller="Tweets" asp-action="Index">Here</a></p>
</div>
