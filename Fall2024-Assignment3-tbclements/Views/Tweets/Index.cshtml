@model IEnumerable<Fall2024_Assignment3_tbclements.Models.Tweet>

@{
    ViewData["Title"] = "Index";
}

<h1>Tweets About Actors</h1>
<table class="indDT">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Actor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Username)
            </th>
            <th>
                Tweet
            </th>
            <th>
                Sentiment
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Actor.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TweetText)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TweetSentiment)
            </td>
        </tr>
}
    </tbody>
</table>
